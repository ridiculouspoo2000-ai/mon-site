/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(self "https://www.helloasso.com" "https://paymenthub.helloassopay.com"), clipboard-write=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'self' blob:; frame-src 'self' blob: https://www.helloasso.com https://*.helloasso.com https://paymenthub.helloassopay.com; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-FourmiAction-Version: 20261112-verre
  Cache-Control: public, max-age=0, must-revalidate

/formateurs
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/formateurs.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/assets/formateurs/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/fourmiaction-vss/atelier/*
  X-Robots-Tag: noindex
  Cache-Control: no-store

/fourmiaction-vss/voix*
  X-Robots-Tag: noindex, nofollow

/assets/collectif/*
  Cache-Control: public, max-age=2592000

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/droit-image-signature*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer

/droit-image-gestion*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  Referrer-Policy: no-referrer
