/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), clipboard-write=(self)
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'self' blob:; frame-src 'self' blob:; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-FourmiAction-Version: 20261001-mobile-4
  Cache-Control: public, max-age=0, must-revalidate

/formateurs
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/formateurs.html
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/assets/formateurs/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store

/fourmiaction-vss/atelier/*
  X-Robots-Tag: noindex
  Cache-Control: no-store
